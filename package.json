{
  "name": "website",
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "fix": "pnpm lint:fix && pnpm format",
    "dev:portfolio": "pnpm run --filter portfolio dev",
    "typecheck": "pnpm --filter portfolio exec astro sync && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test --run",
    "build": "pnpm --filter portfolio build && pnpm --filter slides build"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "@sor4chi/configs": "workspace:*",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
