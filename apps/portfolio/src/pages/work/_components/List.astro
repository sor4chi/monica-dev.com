---
import { Image } from 'astro:assets'

import { getWorkImage } from '@/utils/work'

import { styles } from './List.css'
interface Props {
  items: {
    slug: string
    title: string
    description: string
  }[]
}

const { items } = Astro.props
const animationDelay = 0.1
---

<div class={styles.container} transition:persist>
  {items.map(({ slug, title, description }, i) => (
    <a
      href={`/work/${slug}`}
      class={styles.item}
      style={{
        animationDelay: `${animationDelay * i}s`,
      }}
    >
      <Image
        width={320}
        height={168}
        src={getWorkImage(slug)}
        widths={[320, 640, 800, 1024]}
        sizes="(min-width: 66rem) 31.25rem, (min-width: 43.5rem) calc((100vw - 3.5rem) / 2), calc(100vw - 2rem)"
        format="webp"
        quality={80}
        alt={title}
        class={styles.thumbnail}
      />
      <span class={styles.content}>
        <strong class={styles.title}>{title}</strong>
        <p class={styles.description}>{description}</p>
      </span>
    </a>
  ))}
</div>
