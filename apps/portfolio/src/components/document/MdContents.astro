---
import clsx from 'clsx'

import { SITE_BASE_URL } from '@/config'
import { renderLinkCards } from '@/utils/link-card-html'
import { resolveLinkCard } from '@/utils/link-cards'

import { styles } from './MdContents.css'

const html = await renderLinkCards(
  await Astro.slots.render('default'),
  SITE_BASE_URL,
  resolveLinkCard,
)
---

<div class={clsx(styles.contents, 'markdown-contents')} set:html={html} />

<script>
  document.addEventListener('click', async (event) => {
    if (!(event.target instanceof Element)) return
    const button = event.target.closest('.code-copy-button')
    const code = button?.parentElement?.querySelector('code')
    if (!button || !code) return
    try {
      await navigator.clipboard.writeText(code.innerText)
      button.classList.add('copied')
      setTimeout(() => button.classList.remove('copied'), 1000)
    } catch {
      button.classList.remove('copied')
    }
  })
</script>
