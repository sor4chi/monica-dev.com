---
import { styles } from './Humberger.css'
---

<button
  type="button"
  popovertarget="backward"
  id="navigation-toggle"
  class={styles.button}
  aria-label="ナビゲーションを開閉する"
>
  <svg class={styles.icon} viewBox="0 0 24 24" aria-hidden="true">
    <path class={styles.lines} d="M1 4H23" />
    <path class={styles.lines} d="M1 12H23" />
    <path class={styles.lines} d="M1 20H23" />
  </svg>
</button>
